# trident_repro — API keys
#
# Copy this file to `.env` (NEVER commit `.env`) and fill in the keys you need.
# You only need the keys for providers you intend to use.

# Anthropic — Claude targets and Judge A
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — GPT targets and GPT judges
# https://platform.openai.com
OPENAI_API_KEY=

# Groq — hosts Gemma 2-9B (and Llama variants) via an OpenAI-compatible API.
# Free tier: 14,400 req/day. Used as Judge B to approximate TRIDENT's
# Gemma 2-9B jury member.
# https://console.groq.com
GROQ_API_KEY=

# Optional overrides
# TRIDENT_DATASET_DIR=/Users/yunheehyun/crosssystemeval/data/TRIDENT/dataset
# TRIDENT_LOG_LEVEL=INFO
